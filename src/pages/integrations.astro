---
import Marketing from '../layouts/Marketing.astro';
import Waitlist from '../components/Waitlist.astro';
import LogoTile from '../components/LogoTile.astro';
import { integrationCategories, surfaceLogos } from '../data/content';
---
<Marketing
  title="Integrations"
  description="Total Recall connects the tools you already use, files, notes, email, messages, calendar, health, voice notes, and more, and works inside the apps and AIs you already live in."
>
  <section class="section">
    <div class="container" style="max-width:820px;text-align:center">
      <p class="eyebrow center">Integrations</p>
      <h1 style="font-size:clamp(34px,5vw,54px);margin:10px 0 0">Connect the tools you already use.</h1>
      <p class="lead" style="margin:18px auto 0">
        Point Total Recall at the sources you already rely on. It ingests them privately, keeps up to
        date in the background, and connects everything into one brain.
      </p>
    </div>
  </section>

  <section class="section tight" style="padding-top:0">
    <div class="container">
      {integrationCategories.map((cat) => (
        <div class="intcat">
          <h2 class="clabel">{cat.title}</h2>
          {cat.sub && <p class="csub">{cat.sub}</p>}
          <div class="logo-wall">
            {cat.items.map((it) => <LogoTile n={it.n} f={it.f} mono={it.mono} c={it.c} />)}
          </div>
        </div>
      ))}

      <div class="intcat">
        <h2 class="clabel">Where you use it</h2>
        <p class="csub">theo is your agent in a dedicated app and your messaging channels. Or plug your brain into the AI you already use.</p>
        <div class="logo-wall">
          {surfaceLogos.map((it) => <LogoTile n={it.n} f={it.f} img={it.img} mono={it.mono} c={it.c} />)}
        </div>
      </div>

      <p class="center" style="color:var(--muted);font-size:13.5px;margin-top:40px">
        More integrations are added as the brain grows. Don't see yours? It can probably come in, just ask.
      </p>
    </div>
  </section>

  <Waitlist heading="Bring your whole world together." sub="Total Recall is opening access. Join the waitlist and we'll reach out when it's your turn." />
</Marketing>
