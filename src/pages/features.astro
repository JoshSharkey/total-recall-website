---
import Marketing from '../layouts/Marketing.astro';
import ProductPreview from '../components/ProductPreview.astro';
import Waitlist from '../components/Waitlist.astro';
import LogoTile from '../components/LogoTile.astro';
import { capabilityGroups, surfaceGroups, useCasesAsk, motivations, howItWorks, featuredLogos } from '../data/content';
---
<Marketing
  title="Features"
  description="What Total Recall does: total memory, synthesis, a personal CRM, health, capture, and action, connected across everything you know, and used through Theo or any AI."
>
  <section class="section">
    <div class="container" style="max-width:820px">
      <p class="eyebrow">Features</p>
      <h1 style="font-size:clamp(34px,5vw,56px);margin:10px 0 0">More than memory. Intelligence.</h1>
      <p class="lead" style="margin-top:18px">
        Total Recall takes in everything you know, work and personal, and connects it. The result
        isn't just recall, it's synthesis: it helps you decide, prepare, notice, and act on the
        full picture of your life.
      </p>
    </div>
  </section>

  <section class="section tight">
    <div class="container">
      <div class="feature-grid">
        {capabilityGroups.map((g) => (
          <div class="card">
            <span class="dot" style={`background:${g.color}`}></span>
            <h3>{g.title}</h3>
            <p>{g.blurb}</p>
            <ul>{g.items.map((i) => <li>{i}</li>)}</ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section tight" style="background:#fff;border-top:1px solid var(--line);border-bottom:1px solid var(--line)">
    <div class="container">
      <div style="text-align:center;max-width:720px;margin:0 auto">
        <p class="eyebrow center">How it works</p>
        <h2 style="font-size:clamp(26px,3.6vw,40px)">Set it up once. It works for you forever.</h2>
      </div>
      <div class="steps">
        {howItWorks.map((s) => (
          <div class="step">
            <div class="n" style={`background:${s.color}`}>{s.n}</div>
            <h3>{s.title}</h3>
            <p>{s.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div style="text-align:center;max-width:720px;margin:0 auto">
        <p class="eyebrow center">See it in action</p>
        <h2 style="font-size:clamp(26px,3.6vw,40px)">A brief that thinks. Answers with the receipts.</h2>
      </div>
      <ProductPreview />
    </div>
  </section>

  <section class="section tight" style="background:#fff;border-top:1px solid var(--line)">
    <div class="container">
      <div style="text-align:center">
        <p class="eyebrow center">What it connects</p>
        <h2 style="font-size:clamp(26px,3.6vw,40px)">Bring in your whole world.</h2>
        <p class="lead" style="margin:14px auto 0">The sources you already use, ingested privately and kept up to date.</p>
      </div>
      <div class="logo-wall" style="max-width:820px;margin:30px auto 0">
        {featuredLogos.map((it) => <LogoTile n={it.n} f={it.f} />)}
      </div>
      <div class="center" style="margin-top:26px">
        <a class="btn btn-primary" href="/integrations/">See all integrations →</a>
      </div>
    </div>
  </section>

  <section class="section tight">
    <div class="container">
      <div style="text-align:center">
        <p class="eyebrow center">Where you use it</p>
        <h2 style="font-size:clamp(26px,3.6vw,40px)">Your brain goes where you go.</h2>
        <p class="lead" style="margin:14px auto 0">Talk to Theo in a dedicated app and your messaging channels, or plug your brain into the AI you already use.</p>
      </div>
      <div class="surfaces">
        {surfaceGroups.map((g) => (
          <div class="surface">
            <h3>{g.title}</h3>
            <p class="s-blurb">{g.blurb}</p>
            <div class="tools">{g.tools.map((t) => <span class="toolchip">{t}</span>)}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section tight" style="background:#fff;border-top:1px solid var(--line)">
    <div class="container">
      <div style="text-align:center">
        <p class="eyebrow center">Use it</p>
        <h2 style="font-size:clamp(26px,3.6vw,40px)">Ask it anything. Have it do things.</h2>
      </div>
      <div class="asks">
        {useCasesAsk.map((u) => (
          <div class="askq"><i style={`background:${u.c}`}></i>{u.q}</div>
        ))}
      </div>
    </div>
  </section>

  <section class="section tight">
    <div class="container" style="text-align:center">
      <p class="eyebrow center">Why people build one</p>
      <h2 style="font-size:clamp(24px,3.2vw,34px)">What a second brain gives you.</h2>
      <div class="motiv">{motivations.map((m) => <span>{m}</span>)}</div>
    </div>
  </section>

  <Waitlist heading="Build your second brain." sub="Total Recall is opening access. Join the waitlist and we'll reach out when it's your turn." />
</Marketing>
