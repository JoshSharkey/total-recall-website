---
import Marketing from '../layouts/Marketing.astro';
import Waitlist from '../components/Waitlist.astro';
import ProductPreview from '../components/ProductPreview.astro';
import { surfaceGroups, STREAM } from '../data/content';
const does = [
  [STREAM.gold, 'Briefs you', 'A morning read of what matters: people, decisions, follow-ups, and signals worth your attention.'],
  [STREAM.blue, 'Knows your people', 'A personal CRM that tells you who to reconnect with, and preps you before every call.'],
  [STREAM.green, 'Answers anything', 'Ask in plain language and get answers grounded in everything you know, with the receipts.'],
  [STREAM.violet, 'Connects the dots', 'Synthesis across work, health, and life, surfacing patterns and blind spots on its own.'],
  [STREAM.orange, 'Takes action', 'When you want it to: closes tasks, marks goals, drafts and sends, and nudges you at the right time.'],
  [STREAM.rose, 'Watches your health', 'Recovery, sleep, and trends in context with the rest of your life.'],
];
---
<Marketing
  title="Theo, the agent who knows you"
  description="Theo is the agent built on your Total Recall brain. Talk to it at full strength in the Theo app, across your messaging channels, or plug your brain into any AI you already use."
>
  <section class="section">
    <div class="container" style="max-width:820px">
      <p class="eyebrow">Meet Theo</p>
      <h1 style="font-size:clamp(34px,5vw,56px);margin:10px 0 0">The agent who knows you.</h1>
      <p class="lead" style="margin-top:18px">
        Total Recall is the brain. <strong>Theo</strong> is the agent built on it, the intelligence
        you actually talk to. It works because it has your whole world to draw on: your work, your
        people, your health, your ideas.
      </p>
      <div style="margin-top:26px;display:flex;gap:12px;flex-wrap:wrap">
        <a class="btn btn-primary" href="#waitlist">Get early access →</a>
        <a class="btn btn-ghost" href="/features/">See all features</a>
      </div>
    </div>
  </section>

  <section class="section tight">
    <div class="container">
      <div class="cards">
        {does.map(([c, t, d]) => (
          <div class="card">
            <span class="dot" style={`background:${c}`}></span>
            <h3>{t}</h3>
            <p>{d}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section tight" style="background:#fff;border-top:1px solid var(--line);border-bottom:1px solid var(--line)">
    <div class="container">
      <div style="text-align:center;max-width:720px;margin:0 auto">
        <p class="eyebrow center">See it in action</p>
        <h2 style="font-size:clamp(26px,3.6vw,40px)">Your daily brief. Answers with the receipts.</h2>
      </div>
      <ProductPreview />
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div style="text-align:center;max-width:740px;margin:0 auto">
        <p class="eyebrow center">Everywhere you work</p>
        <h2 style="font-size:clamp(26px,3.6vw,40px)">Full strength in the app. With you everywhere else.</h2>
        <p class="lead" style="margin:14px auto 0">
          The Theo app is the richest way to work with your brain. Theo also rides along in your
          messaging channels, and your brain plugs into any AI you already use.
        </p>
      </div>
      <div class="surfaces">
        {surfaceGroups.map((g) => (
          <div class="surface">
            <h3>{g.title}</h3>
            <p class="s-blurb">{g.blurb}</p>
            <div class="tools">{g.tools.map((t) => <span class="toolchip">{t}</span>)}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <Waitlist heading="Meet your agent." sub="Total Recall is opening access. Join the waitlist and we'll reach out when it's your turn." />
</Marketing>
