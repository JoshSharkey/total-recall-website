---
import Marketing from '../layouts/Marketing.astro';
import Waitlist from '../components/Waitlist.astro';
import TheoShowcase from '../components/TheoShowcase.astro';
import TraceCard from '../components/TraceCard.astro';
import { surfaceGroups, STREAM } from '../data/content';
const learns = [
  { n: '1', color: STREAM.blue, title: 'It retrieves its priors', body: 'Before acting, theo pulls the most similar past decisions and how they scored. In plain terms: it rereads the logbook before making the same kind of call again.' },
  { n: '2', color: STREAM.gold, title: 'It acts, and shows its work', body: 'The decision is written as a trace: the signal, the call, the reasoning, a confidence. In plain terms: every action comes with a receipt.' },
  { n: '3', color: STREAM.green, title: 'You label it by talking', body: '“Good catch.” “No, that’s not done yet.” Natural corrections become permanent outcome labels on the exact trace they refer to. In plain terms: one sentence from you is the whole training loop.' },
  { n: '4', color: STREAM.orange, title: 'It reinforces, or it decays', body: 'Confirmed calls are reinforced. Corrected calls become lessons that block repeats. Stale, unvalidated context decays on a half-life. In plain terms: the mistake you flag today does not come back next month.' },
];
const does = [
  [STREAM.gold, 'Briefs you', 'A morning read of what matters: people, decisions, follow-ups, and signals worth your attention.'],
  [STREAM.blue, 'Knows your people', 'A personal CRM that tells you who to reconnect with, and preps you before every call.'],
  [STREAM.green, 'Answers anything', 'Ask in plain language and get answers grounded in everything you know, with the receipts.'],
  [STREAM.violet, 'Connects the dots', 'Synthesis across work, health, and life, surfacing patterns and blind spots on its own.'],
  [STREAM.orange, 'Takes action', 'When you want it to: closes tasks, marks goals, drafts and sends, and nudges you at the right time.'],
  [STREAM.rose, 'Watches your health', 'Recovery, sleep, and trends in context with the rest of your life.'],
];
---
<Marketing
  title="theo, the agent who knows you"
  description="theo is the agent built on your Total Recall brain. It learns from its own track record and your corrections, and gets better at being your assistant every week. Use it in the theo app, your messaging channels, or any AI you already use."
>
  <section class="section">
    <div class="container" style="max-width:820px">
      <p class="eyebrow">Meet theo</p>
      <h1 style="font-size:clamp(34px,5vw,56px);margin:10px 0 0">The agent who knows you.</h1>
      <p class="lead" style="margin-top:18px">
        Total Recall is the brain. <strong>theo</strong> is the agent built on it, the intelligence
        you actually talk to. It works because it has your whole world to draw on: your work, your
        people, your health, your ideas. And it keeps a record of everything it does for you, so
        it gets better at the job every week.
      </p>
      <div style="margin-top:26px;display:flex;gap:12px;flex-wrap:wrap">
        <a class="btn btn-primary" href="/early-access">Get early access →</a>
        <a class="btn btn-ghost" href="/features/">See all features</a>
      </div>
    </div>
  </section>

  <section class="section tight">
    <div class="container">
      <div class="cards">
        {does.map(([c, t, d]) => (
          <div class="card">
            <span class="dot" style={`background:${c}`}></span>
            <h3>{t}</h3>
            <p>{d}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section tight" style="background:#fff;border-top:1px solid var(--line);border-bottom:1px solid var(--line)">
    <div class="container">
      <div style="text-align:center;max-width:760px;margin:0 auto">
        <p class="eyebrow center">See it in action</p>
        <h2 style="font-size:clamp(26px,3.6vw,40px)">A look inside the app.</h2>
        <p class="lead" style="margin:14px auto 0">
          Your morning brief, answers with the receipts, a task board that runs itself, goals,
          your content's reach, and your health in context. Sample screens, synthetic data.
        </p>
      </div>
      <TheoShowcase />
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div style="text-align:center;max-width:760px;margin:0 auto">
        <p class="eyebrow center">theo learns you</p>
        <h2 style="font-size:clamp(26px,3.6vw,40px)">Correct it once. It remembers forever.</h2>
        <p class="lead" style="margin:14px auto 0">
          Every action theo takes is logged and scored, so the agent is continually
          self-improving. It is accountable to its own track record: the theo you talk to next
          month is better than the one you talk to today, because it has a month more evidence
          of what works for you.
        </p>
      </div>
      <div class="steps">
        {learns.map((s) => (
          <div class="step">
            <div class="n" style={`background:${s.color}`}>{s.n}</div>
            <h3>{s.title}</h3>
            <p>{s.body}</p>
          </div>
        ))}
      </div>
      <TraceCard />
    </div>
  </section>

  <section class="section" style="background:#fff;border-top:1px solid var(--line);border-bottom:1px solid var(--line)">
    <div class="container">
      <div style="text-align:center;max-width:740px;margin:0 auto">
        <p class="eyebrow center">Everywhere you work</p>
        <h2 style="font-size:clamp(26px,3.6vw,40px)">Full strength in the app. With you everywhere else.</h2>
        <p class="lead" style="margin:14px auto 0">
          The theo app is the richest way to work with your brain. theo also rides along in your
          messaging channels, and your brain plugs into any AI you already use.
        </p>
      </div>
      <div class="surfaces">
        {surfaceGroups.map((g) => (
          <div class="surface">
            <h3>{g.title}</h3>
            <p class="s-blurb">{g.blurb}</p>
            <div class="tools">{g.tools.map((t) => <span class="toolchip">{t}</span>)}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <Waitlist heading="Meet your agent." sub="Total Recall is opening access. Answer a short intake once and we'll reach out when it's your turn." />
</Marketing>
