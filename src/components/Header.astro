---
interface Props {
  tone?: 'dark' | 'light';
  solid?: boolean;
  scrollAware?: boolean;
}
const { tone = 'light', solid = false, scrollAware = false } = Astro.props;
---
<header class:list={['site-header', tone === 'dark' && 'on-dark', solid && 'solid', scrollAware && 'scroll-aware']}>
  <div class="bar">
    <a class="brand" href="/">
      <img src="/brand/total-recall-icon.svg" alt="" aria-hidden="true" />
      Total Recall
    </a>
    <nav class="nav">
      <a href="/features/">Features</a>
      <a href="/integrations/">Integrations</a>
      <a href="/theo/">theo</a>
      <a href="/plans/">Plans</a>
      <a href="/docs/" class="hide-sm">Help</a>
    </nav>
    <a href="/#waitlist" class="btn btn-primary nav-cta">Get early access</a>
  </div>
</header>

<script>
  const sa = document.querySelector('.site-header.scroll-aware');
  if (sa) {
    const onScroll = () => sa.classList.toggle('scrolled', window.scrollY > window.innerHeight * 0.7);
    onScroll();
    addEventListener('scroll', onScroll, { passive: true });
  }
</script>
