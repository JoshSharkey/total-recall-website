---
interface Props { n: string; f?: string; img?: string; mono?: boolean; c?: string; }
const { n, f, img, mono, c = '#3b6ff5' } = Astro.props;
const src = img || (f ? `/logos/${f}` : null);
const initials = n.replace(/[^A-Za-z0-9 ]/g, '').split(' ').filter(Boolean).slice(0, 2).map((w) => w[0]).join('').toUpperCase();
---
<div class="logotile" title={n}>
  {src && !mono ? (
    <img class="logo" src={src} alt={n} loading="lazy" />
  ) : (
    <span class="logo mono" style={`color:${c};background:${c}1f`}>{initials}</span>
  )}
  <span class="ln">{n}</span>
</div>
