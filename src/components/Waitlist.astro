---
// The early-access band on marketing pages. Once a Google Form + mailto
// fallback; now a plain CTA into /early-access, the real intake form
// (theo #298) — one question set shared with the setup wizard, so nobody
// answers anything twice. Keeps id="waitlist" so existing #waitlist anchors
// still land here.
import { EARLY_ACCESS_PATH } from '../consts';
interface Props {
  id?: string;
  tone?: 'dark' | 'light';
  heading?: string;
  sub?: string;
}
const {
  id = 'waitlist',
  tone = 'light',
  heading = 'Get early access',
  sub = 'Tell us about yourself once — when your access opens, your setup starts already knowing you.',
} = Astro.props;
---
<section id={id} class:list={['waitlist', tone === 'dark' && 'on-dark']}>
  <div class="container wl-inner">
    <h2>{heading}</h2>
    <p>{sub}</p>
    <div class="wl-cta">
      <a class="btn btn-primary" href={EARLY_ACCESS_PATH}>Request early access →</a>
    </div>
  </div>
</section>
